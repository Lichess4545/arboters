  "query": "\n            SELECT DISTINCT target_user_id, target_channel, target_topic\n            FROM subscriptions\n            WHERE league = ANY($1)\n                AND event = $2\n                AND (source_kind = 'league' OR (source_kind = 'player' AND source_name = ANY($3)))\n            ",
